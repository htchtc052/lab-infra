ACME_EMAIL=you@example.com

API_DOMAIN=api.curatedphoto.example
APP_DOMAIN=app.curatedphoto.example

APP_NAME=CuratedPhoto
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.curatedphoto.example

FRONTEND_URL=https://app.curatedphoto.example
SESSION_DOMAIN=.curatedphoto.example
SANCTUM_STATEFUL_DOMAINS=app.curatedphoto.example

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=curated_photo
DB_USERNAME=curated_photo
DB_PASSWORD=

SESSION_DRIVER=database

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

MAIL_MAILER=log
FILESYSTEM_DISK=local
PHOTO_X_ACCEL=true
